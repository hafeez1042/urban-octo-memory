{
  "name": "typescript-application-boilerplate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "check-types": "turbo run check-types",
    "scaffold": "node scripts/scaffold.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "db:migrate": "pnpm --filter @services/core db:migrate",
    "db:migrate:undo": "pnpm --filter @services/core db:migrate:undo",
    "db:migrate:status": "pnpm --filter @services/core db:migrate:status"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
